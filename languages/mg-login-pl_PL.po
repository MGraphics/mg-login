#. Plugin Name of the plugin
#: mg-login.php
#: includes/class-admin.php:43
#: includes/class-admin.php:44
#: includes/class-admin.php:131
msgid "MG Login"
msgstr "MG Login"

#. Plugin URI of the plugin
#: mg-login.php
msgid "https://github.com/MGraphics/mg-login"
msgstr "https://github.com/MGraphics/mg-login"

#. Description of the plugin
#: mg-login.php
msgid "A branded login screen: your logo, colours and background on a clean card, with the language switcher placed under the form. Styles only the login screen; nothing is added to the public pages."
msgstr "Firmowy ekran logowania: twoje logo, kolory i tło, przejrzysta karta i wybór języka pod formularzem. Zmienia wyłącznie ekran logowania; na publicznych stronach nic nie dodaje."

#. Author of the plugin
#: mg-login.php
msgid "MGraphics"
msgstr "MGraphics"

#. Author URI of the plugin
#: mg-login.php
msgid "https://mgraphics.com.pl"
msgstr "https://mgraphics.com.pl"

#: includes/class-admin.php:77
msgid "Settings"
msgstr "Ustawienia"

#: includes/class-admin.php:99
msgid "Choose the logo"
msgstr "Wybierz logo"

#: includes/class-admin.php:100
msgid "Choose the background image"
msgstr "Wybierz obraz tła"

#: includes/class-admin.php:101
msgid "Use this image"
msgstr "Użyj tego obrazu"

#: includes/class-admin.php:111
msgid "You are not allowed to do this."
msgstr "Nie masz uprawnień do tej operacji."

#: includes/class-admin.php:133
msgid "The look of the login screen. Sign-in itself, the login address and the e-mails are not changed. Leave a field empty to use the automatic value."
msgstr "Wygląd ekranu logowania. Samo logowanie, adres logowania i e-maile się nie zmieniają. Puste pole oznacza wartość automatyczną."

#: includes/class-admin.php:134
msgid "Open the login screen"
msgstr "Otwórz ekran logowania"

#: includes/class-admin.php:139
msgid "The default settings have been restored."
msgstr "Przywrócono ustawienia domyślne."

#: includes/class-admin.php:145
#: includes/class-admin.php:148
msgid "Logo"
msgstr "Logo"

#: includes/class-admin.php:152
msgid "MGraphics logo (default)"
msgstr "Logo MGraphics (domyślne)"

#: includes/class-admin.php:153
#: includes/class-admin.php:239
msgid "Image from the media library"
msgstr "Obraz z biblioteki mediów"

#: includes/class-admin.php:154
msgid "No logo"
msgstr "Bez logo"

#: includes/class-admin.php:158
msgid "A PNG with a transparent background works best; the logo is shown above the card."
msgstr "Najlepiej sprawdza się PNG z przezroczystym tłem; logo jest wyświetlane nad kartą."

#: includes/class-admin.php:162
msgid "Logo width"
msgstr "Szerokość logo"

#. translators: %d: default width in pixels.
#: includes/class-admin.php:168
#, php-format
msgid "Default: %d px. The height follows the image; on phones the logo is about a quarter smaller."
msgstr "Domyślnie: %d px. Wysokość wynika z proporcji obrazu; na telefonach logo jest o około jedną czwartą mniejsze."

#: includes/class-admin.php:174
msgid "Logo link"
msgstr "Link logo"

#: includes/class-admin.php:177
msgid "Empty: the home page of this site."
msgstr "Puste: strona główna tej witryny."

#: includes/class-admin.php:181
msgid "Logo title"
msgstr "Tytuł logo"

#: includes/class-admin.php:184
msgid "Text of the logo link, read by screen readers. Empty: the site title."
msgstr "Tekst linku logo, odczytywany przez czytniki ekranu. Puste: nazwa witryny."

#: includes/class-admin.php:189
msgid "Card"
msgstr "Karta"

#: includes/class-admin.php:192
msgid "Heading"
msgstr "Nagłówek"

#: includes/class-admin.php:194
#: includes/class-login-screen.php:56
msgid "Log in"
msgstr "Logowanie"

#: includes/class-admin.php:195
msgid "Shown above the login form. Empty: \"Log in\" in the language of the login screen."
msgstr "Wyświetlany nad formularzem logowania. Puste: „Logowanie” w języku ekranu logowania."

#: includes/class-admin.php:199
msgid "Card position"
msgstr "Położenie karty"

#: includes/class-admin.php:203
msgid "Left (default)"
msgstr "Po lewej (domyślnie)"

#: includes/class-admin.php:204
msgid "Centre"
msgstr "Na środku"

#: includes/class-admin.php:205
msgid "Right"
msgstr "Po prawej"

#: includes/class-admin.php:208
msgid "On large screens. On tablets and phones the card is always centred."
msgstr "Na dużych ekranach. Na tabletach i telefonach karta jest zawsze na środku."

#: includes/class-admin.php:212
msgid "Language switcher"
msgstr "Wybór języka"

#: includes/class-admin.php:216
msgid "Show the language switcher under the form"
msgstr "Pokazuj wybór języka pod formularzem"

#: includes/class-admin.php:218
msgid "WordPress shows it only when at least one language other than English is installed."
msgstr "WordPress pokazuje go tylko wtedy, gdy zainstalowany jest co najmniej jeden język poza angielskim."

#: includes/class-admin.php:223
msgid "Colours"
msgstr "Kolory"

#: includes/class-admin.php:226
msgid "Accent"
msgstr "Kolor akcentu"

#: includes/class-admin.php:226
msgid "Button, links, field focus and the tick of \"Remember Me\"."
msgstr "Przycisk, linki, obramowanie aktywnego pola i zaznaczenie „Zapamiętaj mnie”."

#: includes/class-admin.php:227
msgid "Accent on hover"
msgstr "Akcent po najechaniu"

#: includes/class-admin.php:227
msgid "Button and links under the mouse; usually a slightly darker accent."
msgstr "Przycisk i linki pod kursorem; zwykle nieco ciemniejszy akcent."

#: includes/class-admin.php:231
msgid "Background"
msgstr "Tło"

#: includes/class-admin.php:234
msgid "Background image"
msgstr "Obraz tła"

#: includes/class-admin.php:238
msgid "MGraphics photo (default)"
msgstr "Zdjęcie MGraphics (domyślne)"

#: includes/class-admin.php:240
msgid "No image, colour only"
msgstr "Bez obrazu, tylko kolor"

#: includes/class-admin.php:244
msgid "The image covers the whole screen; about 1920 × 1080 px is enough."
msgstr "Obraz wypełnia cały ekran; wystarczy około 1920 × 1080 px."

#: includes/class-admin.php:247
msgid "Background colour"
msgstr "Kolor tła"

#: includes/class-admin.php:247
msgid "Shown without an image and while the image loads."
msgstr "Widoczny bez obrazu i podczas jego wczytywania."

#: includes/class-admin.php:249
msgid "Shading"
msgstr "Przyciemnienie"

#: includes/class-admin.php:253
msgid "Darken the background slightly towards the right"
msgstr "Lekko przyciemniaj tło w stronę prawej krawędzi"

#: includes/class-admin.php:259
msgid "Custom CSS"
msgstr "Własny CSS"

#: includes/class-admin.php:262
msgid "Additional CSS"
msgstr "Dodatkowy CSS"

#: includes/class-admin.php:268
msgid "Loaded only on the login screen, after the plugin's styles. Example: <code>body.login #login { border-radius: 0; }</code>"
msgstr "Wczytywany tylko na ekranie logowania, po stylach wtyczki. Przykład: <code>body.login #login { border-radius: 0; }</code>"

#: includes/class-admin.php:283
msgid "Restore all MG Login settings to the defaults?"
msgstr "Przywrócić wszystkie ustawienia MG Login do domyślnych?"

#: includes/class-admin.php:283
msgid "Restore the defaults"
msgstr "Przywróć ustawienia domyślne"

#: includes/class-admin.php:324
msgid "Choose image"
msgstr "Wybierz obraz"

#: includes/class-admin.php:325
msgid "Remove"
msgstr "Usuń"

#: includes/class-login-screen.php:138
msgid "Forgot your password?"
msgstr "Zapomniałeś hasła?"
